# Google Gemini — generador-anuncios
GOOGLE_API_KEY=AIza...

# Supabase — DB y Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI — mantener si otros tools lo usan
OPENAI_API_KEY=sk-...

# Anthropic — buscador-productos (solo se usa en el batch de análisis en CI)
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo de análisis (default claude-sonnet-4-6). Para abaratar:
# PH_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

KIE_API_KEY=

# Whop — cobro de la suscripción ($29/mes) desde la landing.
# Link de checkout del plan creado en Dashboard > Products. Sin esta variable
# la card de precios manda a /signup en vez de cobrar.
WHOP_CHECKOUT_URL=https://whop.com/checkout/plan_xxxxxxxxxxxxx
