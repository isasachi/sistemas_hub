# Google Gemini — generador-anuncios
GOOGLE_API_KEY=AIza...

# Supabase — DB y Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI — mantener si otros tools lo usan
OPENAI_API_KEY=sk-...

# Anthropic — buscador-productos (solo se usa en el batch de análisis en CI)
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo de análisis (default claude-sonnet-4-6). Para abaratar:
# PH_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

KIE_API_KEY=  # respaldo del hub: la key real la carga cada usuario en /ajustes

# ── Suscripción con Whop ──────────────────────────────────────────────────────
WHOP_API_KEY=
# Un checkout link por plan. Whop ata el precio a la suscripción, así que son tres
# links distintos y no un plan con precio variable.
WHOP_PLAN_ID_1=   # $29
WHOP_PLAN_ID_2=   # $69
WHOP_PLAN_ID_3=   # $89
WHOP_WEBHOOK_SECRET=
# Correos con acceso de por vida (los previos al paywall). Entran como plan 3.
# ⚠️ Sin esto, los usuarios actuales chocan contra el paywall al desplegar.
WHOP_GRANDFATHERED_EMAILS=
# ⚠️ SOLO para el sandbox. En producción se OMITE: el default del código ya es
# https://api.whop.com/api/v1
# WHOP_API_BASE=https://sandbox-api.whop.com/api/v1

# Piso del conteo de créditos de imagen: nada anterior a esta fecha cuenta. Evita
# que el historial previo al lanzamiento gaste el primer período.
CREDITS_EPOCH=2026-08-20
